{
  "name": "therassistant-ehr-workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "dev": "pnpm --filter @workspace/therassistant-ehr run dev",
    "build": "pnpm --filter @workspace/therassistant-ehr run build",
    "build:ci": "pnpm --filter @workspace/therassistant-ehr run build:ci",
    "start": "pnpm --filter @workspace/therassistant-ehr run start",
    "lint": "pnpm --filter @workspace/therassistant-ehr run lint",
    "test": "pnpm --filter @workspace/therassistant-ehr run test",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm --filter @workspace/therassistant-ehr run typecheck",
    "test:routes": "node scripts/testing/route-audit.mjs",
    "test:schema": "node scripts/testing/schema-readiness.mjs",
    "test:billing-smoke": "node scripts/testing/billing-smoke.mjs",
    "test:x12": "node scripts/testing/x12-validate.mjs",
    "test:system": "pnpm test:routes && pnpm test:schema && pnpm test:billing-smoke"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@types/pg": "^8.20.0",
    "pg": "^8.20.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.10",
      "esbuild": ">=0.25.0"
    }
  }
}
