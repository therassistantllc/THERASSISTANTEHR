{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/{page,layout,template,loading,error,not-found,route,default}.{ts,tsx}",
    "scripts/**/*.ts",
    "lib/**/__tests__/**/*.test.ts",
    "app/**/__tests__/**/*.test.ts"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "types/**/*.{ts,tsx}",
    "scripts/**/*.ts"
  ],
  "ignore": [
    "app/billing/charges/ChargesClient.tsx",
    "app/billing/denials/DenialsClient.tsx",
    "app/billing/payments/era/EraWorksheetClient.tsx",
    "app/billing/ready-to-generate/ReadyToGenerateClient.tsx",
    "components/billing/BillingSidebar.tsx",
    "components/billing/PlaceholderQueueClient.tsx",
    "components/encounter/InlineCodingHelper.tsx",
    "lib/claims/autoBatchClaimService.ts",
    "lib/claims/edi837pBatchService.ts",
    "lib/navigation/roles.ts",
    "lib/store/userRole.tsx",
    "lib/validation/simulation.tsx"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "server-only",
    "undici",
    "sharp",
    "zustand"
  ],
  "ignoreExports": [
    "fetchChildCodes",
    "default",
    "tabLabel",
    "TRANSMITTED_STATUSES",
    "fetchCodeSetFreshness",
    "isBlockedPlaceOfService",
    "workqueuesByStage",
    "UNIVERSAL_FILTER_IDS",
    "__testing",
    "BILLER_USER_ID",
    "__private999ParserForTests",
    "storeClearinghouseApiKey",
    "listCoreServiceTypeCodes",
    "getSuggestedCodes",
    "getClarifyingQuestions",
    "formatRecommendationSummary",
    "getAuthenticatedUser",
    "_resetSchemaCacheForTests"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "warn",
    "duplicates": "error",
    "unresolved": "error",
    "binaries": "error",
    "exports": "warn",
    "types": "warn",
    "nsExports": "warn",
    "nsTypes": "warn",
    "dependencies": "warn",
    "devDependencies": "warn",
    "unlisted": "warn",
    "enumMembers": "off"
  }
}
